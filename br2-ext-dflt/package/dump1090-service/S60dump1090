#!/bin/sh
#
# Run the dump1090 daemon
#

DAEMON="dump1090"
PIDFILE="/var/run/$DAEMON.pid"


start() {
	echo -n "Starting $DAEMON... "
	# Restart the daemon if it exits
	start-stop-daemon -S -b -m -p $PIDFILE -x /usr/bin/restart.sh -- $DAEMON "/usr/bin/$DAEMON --net --net-bind-address 127.0.0.1"
	[ $? -eq 0 ] && echo "OK" || echo "ERROR"
}

stop() {
	echo -n "Stopping $DAEMON... "
	start-stop-daemon -K -p $PIDFILE
	[ $? -eq 0 ] && echo "OK" || echo "ERROR"
}

restart() {
	stop
	start
}

case "$1" in
  start|stop|restart)
	"$1"
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
